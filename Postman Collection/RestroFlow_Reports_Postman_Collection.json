        }
      }
    },
    {
      "name": "Payment Report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/payments?fromDate={{fromDate}}&toDate={{toDate}}"
        }
      }
    },
    {
      "name": "Order Report",
      "request": {
        "method": "GET",
