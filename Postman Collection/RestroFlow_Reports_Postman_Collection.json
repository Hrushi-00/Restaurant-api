{
  "info": {
    "_postman_id": "restroflow-reports-2026",
    "name": "RestroFlow - Reports",
    "description": "Postman collection for RestroFlow Reports APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "fromDate",
      "value": "2026-08-01"
    },
    {
      "key": "toDate",
      "value": "2026-08-12"
    }
  ],
  "item": [
    {
      "name": "Dashboard Report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/dashboard"
        }
      }
    },
    {
      "name": "Sales Report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/sales?fromDate={{fromDate}}&toDate={{toDate}}"
        }
      }
    },
    {
      "name": "Purchase Report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/reports/purchases?fromDate={{fromDate}}&toDate={{toDate}}"
        }
      }
    },
    {
      "name": "Inventory Report",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
