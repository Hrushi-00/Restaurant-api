{
  "info": {
    "_postman_id": "restroflow-audit-log-2026",
    "name": "RestroFlow - Audit Logs",
    "description": "Postman collection for RestroFlow Audit Log APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "auditLogId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "recordId",
      "value": ""
    },
    {
      "key": "module",
      "value": "ORDER"
    },
    {
      "key": "fromDate",
      "value": "2026-08-01"
    },
    {
      "key": "toDate",
      "value": "2026-08-12"
    }
  ],
  "item": [
    {
      "name": "Audit Log List",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/list?page=1&limit=20",
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Audit Log List - Filter",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/list?page=1&limit=20&module={{module}}&fromDate={{fromDate}}&toDate={{toDate}}",
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            },
            {
              "key": "module",
              "value": "{{module}}"
            },
            {
              "key": "fromDate",
              "value": "{{fromDate}}"
            },
            {
              "key": "toDate",
              "value": "{{toDate}}"
            }
          ]
        }
      }
    },
    {
      "name": "Audit Log Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/details/{{auditLogId}}"
        }
      }
    },
    {
      "name": "Audit Logs By User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/user/{{userId}}?page=1&limit=20",
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Audit Logs By Module",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/module/{{module}}?page=1&limit=20",
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "20"
            }
          ]
        }
      }
    },
    {
      "name": "Audit Logs By Record",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/audit-logs/record/{{recordId}}"
        }
      }
    }
  ]
}