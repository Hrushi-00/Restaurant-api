        "body": {
          "mode": "raw",
          "raw": "{\n    \"customerName\": \"Hrushikesh\",\n    \"customerPhone\": \"9999999999\",\n    \"orderType\": \"TAKEAWAY\",\n    \"items\": [\n        {\n            \"menuId\": \"687b7fdbe1b59a78d89d7dbd\",\n            \"quantity\": 3\n        }\n    ],\n    \"discount\": 100,\n    \"paymentMethod\": \"CARD\",\n    \"notes\": \"Extra Cheese\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/update/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "update",
            "{{orderId}}"
          ]
        }
      }
    },
