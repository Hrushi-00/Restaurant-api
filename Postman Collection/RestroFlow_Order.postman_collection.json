    "name": "RestroFlow - Order Module",
    "description": "Order Module APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/orders"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"customerName\": \"Hrushikesh Kapse\",\n    \"customerPhone\": \"9876543211\",\n    \"orderType\": \"DINE_IN\",\n    \"items\": [\n        {\n            \"menuId\": \"687b7fdbe1b59a78d89d7dbd\",\n            \"quantity\": 2\n        },\n        {\n            \"menuId\": \"687b80a6e1b59a78d89d7dd0\",\n            \"quantity\": 1\n        }\n    ],\n    \"discount\": 50,\n    \"paymentMethod\": \"UPI\",\n    \"notes\": \"Less spicy\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "create"
          ]
        }
      }
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
